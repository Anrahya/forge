{
  "name": "forge-dsh",
  "description": "forge: a verification-first engineering workflow for non-frontier coding models, packaged as a DeepSeek Harness plugin. Per-phase tool policy, playbook re-injection, a verify gate before a turn may end, role-routed subagents, 14 deterministic gates.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "skills",
    "scripts",
    "templates",
    "AGENTS.md",
    "DESIGN.md",
    "forge.toml",
    "cordis.patch.yml",
    "cordis.yml",
    "dshx.yml",
    "README.md",
    "adapters"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "selftest": "bash scripts/gates/selftest.sh"
  },
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.3.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "forge",
    "agent-skills",
    "verification"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anrahya/forge.git"
  },
  "homepage": "https://github.com/Anrahya/forge"
}
